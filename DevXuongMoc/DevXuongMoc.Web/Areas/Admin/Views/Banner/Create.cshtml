@model DevXuongMoc.Domain.Entities.Banner

@{
    ViewData["Title"] = "Thêm Banner";
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Thêm Banner mới</h5>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Banner" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Placement" class="form-label fw-bold">Vị trí hiển thị <span class="text-danger">*</span></label>
                    <select asp-for="Placement" class="form-select" required>
                        <option value="">-- Chọn vị trí --</option>
                        <option value="1">1 - Hero (Ảnh bìa đầu trang chủ)</option>
                        <option value="2">2 - Product Slider (Slider sản phẩm)</option>
                        <option value="3">3 - Category (Ảnh danh mục)</option>
                    </select>
                    <span asp-validation-for="Placement" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="LinkUrl" class="form-label fw-bold">Đường dẫn khi click (Link URL)</label>
                    <input asp-for="LinkUrl" class="form-control" placeholder="VD: /san-pham hoặc https://..." />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StartsAt" class="form-label fw-bold">Bắt đầu hiển thị</label>
                    <input asp-for="StartsAt" class="form-control" type="datetime-local" />
                    <div class="form-text">Để trống để hiển thị ngay lập tức.</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EndsAt" class="form-label fw-bold">Kết thúc hiển thị</label>
                    <input asp-for="EndsAt" class="form-control" type="datetime-local" />
                    <div class="form-text">Để trống để hiển thị vĩnh viễn.</div>
                    <span asp-validation-for="EndsAt" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-4 form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                <label asp-for="IsActive" class="form-check-label fw-bold">Bật Banner này</label>
            </div>

            <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Lưu lại</button>
            <a asp-area="Admin" asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}