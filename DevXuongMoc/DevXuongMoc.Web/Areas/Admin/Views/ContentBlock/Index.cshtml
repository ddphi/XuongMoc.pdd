@model IEnumerable<DevXuongMoc.Domain.Entities.ContentBlock>

@{
    ViewData["Title"] = "Quản lý Nội dung trang";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-area="Admin" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Thêm Khối nội dung
    </a>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nhóm (Group)</th>
            <th>Mã định danh (Key)</th>
            <th>Nội dung (HTML)</th>
            <th>Thứ tự</th>
            <th class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>
                    @if (item.Group == 1)
                    {
                        <span class="badge bg-primary">Trang Chủ</span>
                    }
                    else if (item.Group == 2)
                    {

                        <span class="badge bg-info text-dark">Trang Giới Thiệu</span>
                    }
                    else
                    {

                        <span class="badge bg-secondary">Nhóm khác (@item.Group)</span>
                    }
                </td>
                <td class="fw-bold">@item.Key</td>
                <td>
                    <!-- Hiển thị text thuần, cắt bớt cho gọn -->
                    @(item.ContentHtml != null && item.ContentHtml.Length > 50 ? item.ContentHtml.Substring(0, 50) + "..." : item.ContentHtml)
                </td>
                <td>@item.SortOrder</td>
                <td class="text-center">
                    <form asp-area="Admin" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa khối nội dung này?');">
                        <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                    </form>
                    <a asp-area="Admin" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                </td>
            </tr>
        }
    </tbody>
</table>