@model DevXuongMoc.Domain.Entities.Category

@{
    ViewData["Title"] = "Chi tiết Danh mục";
}

<div class="card shadow-sm">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Chi tiết Danh mục</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Tên Danh Mục</dt>
            <dd class="col-sm-9 fw-bold">@Model.Name</dd>

            <dt class="col-sm-3">Đường dẫn (Slug)</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Slug</span></dd>

            <dt class="col-sm-3">Thứ tự</dt>
            <dd class="col-sm-9">@Model.SortOrder</dd>

            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">
                @if (Model.IsVisible)
                {
                    <span class="badge bg-success">Hiển thị</span>
                }
                else
                {
                    <span class="badge bg-danger">Đang ẩn</span>
                }
            </dd>

            <dt class="col-sm-3">Icon</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrEmpty(Model.IconPath))
                {
                    <!-- Hiển thị ảnh nếu có đường dẫn -->
                    <img src="@Model.IconPath" alt="Icon" style="width: 50px; height: 50px; object-fit: contain;" class="border rounded p-1" />
                    <br />
                    <small class="text-muted">@Model.IconPath</small>
                }
                else
                {
                    <span class="text-muted">Không có icon</span>
                }
            </dd>
        </dl>

        <hr />
        <a asp-area="Admin" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Sửa</a>
        <a asp-area="Admin" asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
    </div>
</div>