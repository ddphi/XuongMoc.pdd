@model DevXuongMoc.Domain.Entities.Category

@{
    ViewData["Title"] = "Chỉnh sửa Danh mục";
}

<div class="card shadow-sm">
    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Chỉnh sửa Danh mục</h5>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Category" asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Cần có Id ẩn để biết đang sửa bản ghi nào -->
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold">Tên Danh Mục <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label fw-bold">Đường dẫn (Slug)</label>
                <input asp-for="Slug" class="form-control" />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SortOrder" class="form-label fw-bold">Thứ tự hiển thị</label>
                    <input asp-for="SortOrder" class="form-control" type="number" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="IconPath" class="form-label fw-bold">Đường dẫn Icon</label>
                    <input asp-for="IconPath" class="form-control" />
                </div>
            </div>

            <div class="mb-4 form-check form-switch">
                <input asp-for="IsVisible" class="form-check-input" type="checkbox" />
                <label asp-for="IsVisible" class="form-check-label">Hiển thị danh mục này</label>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Cập nhật</button>
            <a asp-area="Admin" asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}