    @model DevXuongMoc.Domain.Entities.Product

@{
    ViewData["Title"] = "Thêm mới Sản phẩm";
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        Thêm mới Sản phẩm
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Tên Sản Phẩm <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="CategoryId" class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories" required>
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label fw-bold">Đường dẫn (Slug)</label>
                <input asp-for="Slug" class="form-control" placeholder="Để trống để tự động tạo..." />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ShortDescription" class="form-label fw-bold">Mô tả ngắn</label>
                    <textarea asp-for="ShortDescription" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ShortSpec" class="form-label fw-bold">Thông số ngắn</label>
                    <textarea asp-for="ShortSpec" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Spec" class="form-label fw-bold">Thông số kỹ thuật chi tiết (HTML)</label>
                <textarea asp-for="Spec" class="form-control" rows="4"></textarea>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="WarrantyMonths" class="form-label fw-bold">Bảo hành (tháng)</label>
                    <input asp-for="WarrantyMonths" class="form-control" type="number" value="12" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Status" class="form-label fw-bold">Trạng thái (0=Ẩn, 1=Hiện)</label>
                    <input asp-for="Status" class="form-control" type="number" value="1" />
                </div>
                <div class="col-md-4 mb-3 d-flex align-items-end">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                        <label asp-for="IsFeatured" class="form-check-label fw-bold">Sản phẩm nổi bật</label>
                    </div>
                </div>
            </div>

            <div class="mb-4 border-top pt-3">
                <!-- Thêm 1 ID cho thẻ input để JS dễ bắt sự kiện -->
                <label class="form-label fw-bold">Hình ảnh sản phẩm (Có thể chọn nhiều ảnh)</label>
                <input type="file" id="imageInput" name="ImageFiles" class="form-control" multiple accept="image/*" />

                <!-- Khung chứa các ảnh xem trước -->
                <div id="imagePreview" class="d-flex flex-wrap gap-2 mt-3"></div>
            </div>

            <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Lưu lại</button>
            <a asp-area="Admin" asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const imageInput = document.getElementById('imageInput');
            const imagePreview = document.getElementById('imagePreview');
            // Đối tượng dùng để tích lũy file
            let dataTransfer = new DataTransfer();

            imageInput.addEventListener('change', function (event) {
                const newFiles = event.target.files;

                // 1. Cộng dồn các file mới vào danh sách
                for (let i = 0; i < newFiles.length; i++) {
                    dataTransfer.items.add(newFiles[i]);
                }

                // 2. Gán lại danh sách file đã cộng dồn cho thẻ input
                imageInput.files = dataTransfer.files;

                // 3. Vẽ lại giao diện xem trước
                renderPreview();
            });

            function renderPreview() {
                imagePreview.innerHTML = ''; // Xóa khung preview cũ
                const files = imageInput.files;

                for (let i = 0; i < files.length; i++) {
                    const file = files[i];

                    if (file.type.startsWith('image/')) {
                        const reader = new FileReader();

                        reader.onload = function (e) {
                            // Tạo khung bao bọc (Container)
                            const container = document.createElement('div');
                            container.className = 'position-relative text-center';
                            container.style.width = '100px';

                            // Tạo thẻ ảnh
                            const img = document.createElement('img');
                            img.src = e.target.result;
                            img.style.width = '100px';
                            img.style.height = '100px';
                            img.style.objectFit = 'cover';
                            img.style.borderRadius = '10px';
                            img.style.border = '1px solid #ccc';

                            // Tạo tên file
                            const fileName = document.createElement('div');
                            fileName.style.fontSize = '11px';
                            fileName.style.marginTop = '5px';
                            fileName.style.wordBreak = 'break-all';
                            fileName.innerText = file.name;

                            // Tạo nút Xóa (X) trên góc ảnh
                            const btnRemove = document.createElement('button');
                            btnRemove.type = 'button';
                            btnRemove.className = 'btn btn-sm btn-danger position-absolute';
                            btnRemove.style.top = '2px';
                            btnRemove.style.right = '2px';
                            btnRemove.style.padding = '2px 6px';
                            btnRemove.style.fontSize = '12px';
                            btnRemove.innerHTML = '&times;'; // Dấu X

                            // Xử lý sự kiện khi bấm nút Xóa
                            btnRemove.onclick = function() {
                                removeFile(i);
                            };

                            container.appendChild(img);
                            container.appendChild(fileName);
                            container.appendChild(btnRemove);
                            imagePreview.appendChild(container);
                        };

                        reader.readAsDataURL(file);
                    }
                }
            }

            // Hàm xóa ảnh khỏi danh sách nếu chọn nhầm
            function removeFile(indexToRemove) {
                const dt = new DataTransfer(); // Tạo DataTransfer mới
                const files = imageInput.files;

                for (let i = 0; i < files.length; i++) {
                    if (i !== indexToRemove) {
                        dt.items.add(files[i]); // Giữ lại những ảnh không bị xóa
                    }
                }

                imageInput.files = dt.files; // Gán lại
                dataTransfer = dt; // Cập nhật lại biến lưu trữ
                renderPreview(); // Vẽ lại
            }
        });
    </script>
}