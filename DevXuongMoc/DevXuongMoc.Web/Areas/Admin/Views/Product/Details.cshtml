@model DevXuongMoc.Domain.Entities.Product

@{
    ViewData["Title"] = "Chi tiết Sản phẩm";
}

<div class="card shadow-sm">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Chi tiết Sản phẩm: @Model.Name</h5>
        <span class="badge bg-light text-dark">ID: @Model.Id</span>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- CỘT TRÁI: HÌNH ẢNH & BIẾN THỂ -->
            <div class="col-md-4 mb-4">
                <!-- Hình ảnh -->
                <h6 class="fw-bold border-bottom pb-2 text-primary"><i class="bi bi-images"></i> Hình ảnh</h6>
                @if (Model.ProductImages != null && Model.ProductImages.Any())
                {
                    <div class="row g-2 mb-4">
                        @foreach (var img in Model.ProductImages)
                        {
                            <div class="col-6 position-relative">
                                <img src="@img.Path" class="img-fluid rounded border" style="height: 120px; width: 100%; object-fit: cover;" />
                                @if (img.IsPrimary)
                                {
                                    <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-1" style="font-size: 10px;">Ảnh đại diện</span>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted fst-italic mb-4">Chưa có hình ảnh.</p>
                }

                <!-- Biến thể (Variants) -->
                <h6 class="fw-bold border-bottom pb-2 text-primary"><i class="bi bi-boxes"></i> Variant</h6>
                @if (Model.ProductVariants != null && Model.ProductVariants.Any())
                {
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Chất liệu</th>
                                <th>Giá gốc</th>
                                <th>Giá bán</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.ProductVariants)
                            {
                                <tr>
                                    <td class="fw-bold">@v.MaterialName</td>
                                    <td class="text-muted text-decoration-line-through">@v.OriginalPrice.ToString("N0") đ</td>
                                    <td class="text-danger fw-bold">@v.SalePrice.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted fst-italic">Chưa có biến thể.</p>
                }
            </div>

            <!-- CỘT PHẢI: THÔNG TIN CHI TIẾT -->
            <div class="col-md-8">
                <h6 class="fw-bold border-bottom pb-2 text-primary"><i class="bi bi-card-text"></i> Thông tin chung</h6>
                <table class="table table-sm table-bordered mb-4">
                    <tr><th width="30%">Tên sản phẩm</th><td class="fw-bold text-primary fs-5">@Model.Name</td></tr>
                    <tr><th>Danh mục</th><td>@Model.Category?.Name</td></tr>
                    <tr><th>Đường dẫn (Slug)</th><td><span class="badge bg-secondary">@Model.Slug</span></td></tr>
                    <tr>
                        <th>Trạng thái</th>
                        <td>
                            @if (Model.Status == 1)
                            {
                                <span class="badge bg-success">Đang hiển thị</span>
                            }
                            else
                            {

                                <span class="badge bg-danger">Đang ẩn</span>
                            }

                            @if (Model.IsFeatured)
                            {
                                <span class="badge bg-warning text-dark ms-2">Sản phẩm nổi bật</span>
                            }
                            @if (Model.IsDeleted)
                            {
                                <span class="badge bg-dark ms-2">Đã xóa mềm</span>
                            }
                        </td>
                    </tr>
                    <tr><th>Bảo hành</th><td>@Model.WarrantyMonths tháng</td></tr>
                    <tr><th>Đánh giá / Lượt xem</th><td>@Model.Rating sao / @Model.ViewCount lượt xem</td></tr>
                </table>

                <h6 class="fw-bold border-bottom pb-2 text-primary"><i class="bi bi-file-text"></i> Nội dung mô tả</h6>
                <table class="table table-sm table-bordered mb-4">
                    <tr><th width="30%">Mô tả ngắn</th><td>@Model.ShortDescription</td></tr>
                    <tr><th>Thông số ngắn</th><td>@Model.ShortSpec</td></tr>
                    <tr><th>Thông số kỹ thuật (Spec)</th><td>@Html.Raw(Model.Spec)</td></tr>
                    <tr><th>Cách bảo quản (Care)</th><td>@Html.Raw(Model.Care)</td></tr>
                    <tr><th>Chế độ bảo hành (Warranty)</th><td>@Html.Raw(Model.Warranty)</td></tr>
                    <tr><th>Cam kết (Commitment)</th><td>@Html.Raw(Model.Commitment)</td></tr>
                    <tr><th>Tính năng (Features)</th><td>@Html.Raw(Model.Features)</td></tr>
                </table>

                <h6 class="fw-bold border-bottom pb-2 text-primary"><i class="bi bi-clock-history"></i> Thông tin hệ thống</h6>
                <table class="table table-sm table-bordered text-muted" style="font-size: 0.85rem;">
                    <tr>
                        <th width="30%">Ngày tạo</th>
                        <td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss") (@(Model.CreatedBy ?? "Hệ thống"))</td>
                    </tr>
                    <tr>
                        <th>Ngày cập nhật cuối</th>
                        <td>@(Model.UpdatedAt.HasValue? Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm:ss") : "Chưa cập nhật") (@(Model.UpdatedBy ?? "N/A"))</td>
                    </tr>
                </table>
            </div>
        </div>

        <hr />
        <a asp-area="Admin" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Sửa Sản phẩm</a>
        <a asp-area="Admin" asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
    </div>
</div>