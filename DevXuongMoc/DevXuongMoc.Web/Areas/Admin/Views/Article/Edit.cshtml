@model DevXuongMoc.Domain.Entities.Article

@{
    ViewData["Title"] = "Chỉnh sửa Bài viết";
}

<div class="card shadow-sm">
    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0">Chỉnh sửa Bài viết</h5>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Article" asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Title" class="form-label fw-bold">Tiêu đề bài viết <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" required />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="PublishedAt" class="form-label fw-bold">Ngày đăng (Hẹn giờ)</label>
                    <input asp-for="PublishedAt" class="form-control" type="datetime-local" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label fw-bold">Đường dẫn (Slug)</label>
                <input asp-for="Slug" class="form-control" />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BodyHtml" class="form-label fw-bold">Nội dung bài viết (HTML)</label>
                <textarea asp-for="BodyHtml" class="form-control" rows="12"></textarea>
            </div>

            <div class="mb-4">
                <label asp-for="Status" class="form-label fw-bold">Trạng thái</label>
                <select asp-for="Status" class="form-select">
                    <option value="0">Bản nháp (Ẩn)</option>
                    <option value="1">Xuất bản (Hiện)</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Cập nhật</button>
            <a asp-area="Admin" asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}