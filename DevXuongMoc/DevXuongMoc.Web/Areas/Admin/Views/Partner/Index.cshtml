@model IEnumerable<DevXuongMoc.Domain.Entities.Partner>

@{
    ViewData["Title"] = "Quản lý Đối tác";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-area="Admin" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Thêm Đối tác mới
    </a>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Logo</th>
            <th>Tên Đối tác</th>
            <th>Hiện ở Trang chủ</th>
            <th>Trạng thái</th>
            <th class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.LogoPath))
                    {
                        <img src="@item.LogoPath" style="height: 40px; max-width: 100px; object-fit: contain; border: 1px solid #ddd; border-radius: 4px; padding: 2px;" />
                    }
                    else
                    {
                        <span class="text-muted">Chưa có</span>
                    }
                </td>
                <td class="fw-bold">@item.Name</td>
                <td>
                    @if (item.ShowOnHome)
                    {
                        <span class="badge bg-info text-dark">Có</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Không</span>
                    }
                </td>
                <td>
                    @if (item.IsVisible)
                    {
                        <span class="badge bg-success">Hiển thị</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Đang ẩn</span>
                    }
                </td>
                <td class="text-center">
                    <form asp-area="Admin" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa đối tác này?');">
                        <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                    </form>
                    <a asp-area="Admin" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                </td>
            </tr>
        }
    </tbody>
</table>