@model DevXuongMoc.Domain.Entities.Partner

@{
    ViewData["Title"] = "Chỉnh sửa Đối tác";
}

<div class="card shadow-sm">
    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0">Chỉnh sửa Đối tác</h5>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Partner" asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="LogoPath" /> <!-- Giữ lại đường dẫn cũ -->

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold">Tên Đối tác <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Logo hiện tại</label> <br />
                @if (!string.IsNullOrEmpty(Model.LogoPath))
                {
                    <img src="@Model.LogoPath" style="height: 60px; border: 1px solid #ddd; border-radius: 5px; margin-bottom: 10px;" />
                }
                else
                {
                    <span class="text-muted d-block mb-2">Chưa có logo</span>
                }

                <input type="file" name="LogoFile" class="form-control" accept="image/*" />
                <div class="form-text">Để trống nếu không muốn thay đổi Logo.</div>
            </div>

            <div class="mb-3 form-check form-switch">
                <input asp-for="ShowOnHome" class="form-check-input" type="checkbox" />
                <label asp-for="ShowOnHome" class="form-check-label fw-bold">Hiển thị ở dải Logo Trang chủ</label>
            </div>

            <div class="mb-4 form-check form-switch">
                <input asp-for="IsVisible" class="form-check-input" type="checkbox" />
                <label asp-for="IsVisible" class="form-check-label fw-bold">Trạng thái Hiển thị chung</label>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Cập nhật</button>
            <a asp-area="Admin" asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}